# Copy to .env and fill in. .env is gitignored.

# --- Layer 2 / Module C infrastructure enrichment (both optional) ---
# ASN lookup falls back to ip-api.com (free, no key, ~45 req/min) if unset.
IPINFO_TOKEN=
WHOIS_API_KEY=

# --- Dataset (scripts/pull_dataset.py) ---
# OpenPhish community feed needs NO key.
# PhishTank requires a FREE registered app key:
#   https://www.phishtank.com/developer_info.php
PHISHTANK_API_KEY=

# Override the shared store location if needed
CSBI_STORE_PATH=data/store/scans.db
